/* DarlingV2 - только мех-свичи 4×7, без HE */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan_darling;
        zmk,physical-layout = &physical_layout0;
    };

    /* Each half scans 4x7; the shared logical matrix is 4x14. */
    kscan_darling: kscan_darling0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        /* col-gpios и row-gpios в overlay */
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Darling3 Default";
        kscan = <&kscan_darling>;
        transform = <&default_transform>;
        
        /* Ordered like the keymap: left columns 0-6, then right 7-13. */
        keys =
            /* JSON rows 2 and 3 */
            <&key_physical_attrs 100 100   50 138 0   0   0>
            , <&key_physical_attrs 100 100 150 138 0   0   0>
            , <&key_physical_attrs 100 100 250 138 0   0   0>
            , <&key_physical_attrs 100 100 350 138 0   0   0>
            , <&key_physical_attrs 100 100 450 138 0   0   0>
            , <&key_physical_attrs 100 100 550 138 0   0   0>
            , <&key_physical_attrs 100 100 650 138 0   0   0>
            , <&key_physical_attrs 100 100  925 138 0   0   0>
            , <&key_physical_attrs 100 100 1025 138 0   0   0>
            , <&key_physical_attrs 100 100 1125 138 0   0   0>
            , <&key_physical_attrs 100 100 1225 138 0   0   0>
            , <&key_physical_attrs 100 100 1325 138 0   0   0>
            , <&key_physical_attrs 100 100 1425 138 0   0   0>
            , <&key_physical_attrs 100 100 1525 138 0   0   0>

            /* JSON rows 4 and 5 */
            , <&key_physical_attrs 100 100   50 238 0   0   0>
            , <&key_physical_attrs 100 100 150 238 0   0   0>
            , <&key_physical_attrs 100 100 250 238 0   0   0>
            , <&key_physical_attrs 100 100 350 238 0   0   0>
            , <&key_physical_attrs 100 100 450 238 0   0   0>
            , <&key_physical_attrs 100 100 550 238 0   0   0>
            , <&key_physical_attrs 100 100 650 238 0   0   0>
            , <&key_physical_attrs 100 100  925 238 0   0   0>
            , <&key_physical_attrs 100 100 1025 238 0   0   0>
            , <&key_physical_attrs 100 100 1125 238 0   0   0>
            , <&key_physical_attrs 100 100 1225 238 0   0   0>
            , <&key_physical_attrs 100 100 1325 238 0   0   0>
            , <&key_physical_attrs 100 100 1425 238 0   0   0>
            , <&key_physical_attrs 100 100 1525 238 0   0   0>

            /* JSON rows 6 and 7 */
            , <&key_physical_attrs 100 100   50 338 0   0   0>
            , <&key_physical_attrs 100 100 150 338 0   0   0>
            , <&key_physical_attrs 100 100 250 338 0   0   0>
            , <&key_physical_attrs 100 100 350 338 0   0   0>
            , <&key_physical_attrs 100 100 450 338 0   0   0>
            , <&key_physical_attrs 100 100 550 338 0   0   0>
            , <&key_physical_attrs 100 100 650 338 0 650 425>
            , <&key_physical_attrs 100 100  925 338 0   0   0>
            , <&key_physical_attrs 100 100 1025 338 0   0   0>
            , <&key_physical_attrs 100 100 1125 338 0   0   0>
            , <&key_physical_attrs 100 100 1225 338 0   0   0>
            , <&key_physical_attrs 100 100 1325 338 0   0   0>
            , <&key_physical_attrs 100 100 1425 338 0   0   0>
            , <&key_physical_attrs 100 100 1525 338 0 650 425>

            /* JSON rows 8 and 9 */
            , <&key_physical_attrs 100 100   50 438 0   0   0>
            , <&key_physical_attrs 100 100 150 438 0   0   0>
            , <&key_physical_attrs 100 100 250 438 0   0   0>
            , <&key_physical_attrs 100 100 350 438 0   0   0>
            , <&key_physical_attrs 100 100 450 438 0   0   0>
            , <&key_physical_attrs 100 100 550 438 0 650 425>
            , <&key_physical_attrs 100 100 650 438 0 650 425>
            , <&key_physical_attrs 100 100  925 438 0   0   0>
            , <&key_physical_attrs 100 100 1025 438 0   0   0>
            , <&key_physical_attrs 100 100 1125 438 0   0   0>
            , <&key_physical_attrs 100 100 1225 438 0   0   0>
            , <&key_physical_attrs 100 100 1325 438 0   0   0>
            , <&key_physical_attrs 100 100 1425 438 0 650 425>
            , <&key_physical_attrs 100 100 1525 438 0 650 425>
            ;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
        >;
    };
};
