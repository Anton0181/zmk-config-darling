#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * ============================================================
         * BASE LAYER
         * ============================================================
         *
         * LEFT  = 28 keys
         * RIGHT = 28 keys
         *
         * Total = 56 keys
         *
         * ------------------------------------------------------------
         *
         * LEFT                              RIGHT
         *
         * TAB  Q  W  E  R  T  Y             U  I  O  P  [  ]  \
         * CAPS A  S  D  F  G  H             J  K  L  ;  '  ,  .
         * SHFT Z  X  C  V  B  N             M  ,  .  /  -  =  BSPC
         * CTRL ALT GUI NUM SYM SPC           NAV BT GUI CTRL SPC RET
         *
         * ============================================================
         */

        base_layer {
            bindings = <
                /* LEFT */
                &kp TAB       &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y
                &kp CAPS      &kp A        &kp S        &kp D        &kp F        &kp G        &kp H
                &kp LSHFT     &kp Z        &kp X        &kp C        &kp V        &kp B        &kp N
                &kp LCTRL     &kp LALT     &kp LGUI     &mo 1        &mo 2        &kp SPACE    &mo 4

                /* RIGHT */
                &kp U         &kp I        &kp O        &kp P        &kp LBKT     &kp RBKT     &kp BSLH
                &kp J         &kp K        &kp L        &kp SEMI      &kp SQT       &kp COMMA     &kp DOT
                &kp M         &kp COMMA    &kp DOT      &kp FSLH      &kp MINUS     &kp EQUAL     &kp BSPC
                &mo 3         &mo 4        &kp RGUI     &kp RCTRL     &kp SPACE     &kp RET
            >;
        };


        /*
         * ============================================================
         * NUMBERS
         * ============================================================
         *
         * LEFT:
         *
         * 1 2 3 4 5 6 7
         * 8 9 0 - + =
         * ( ) [ ] { }
         * TRANS TRANS TRANS TRANS TRANS TRANS
         *
         * RIGHT:
         *
         * 8 9 0
         * 4 5 6
         * 1 2 3
         * 0 . ENTER
         *
         * ============================================================
         */

        num_layer {
            bindings = <
                /* LEFT */
                &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6        &kp N7
                &kp N8        &kp N9        &kp N0        &kp MINUS     &kp PLUS      &kp EQUAL     &kp ASTERISK
                &kp LPAR      &kp RPAR      &kp LBKT      &kp RBKT       &kp LBRC      &kp RBRC       &kp FSLH
                &trans        &trans        &trans        &trans         &trans        &trans        &trans

                /* RIGHT */
                &kp N7        &kp N8        &kp N9        &kp PLUS       &kp MINUS     &kp ASTERISK &kp FSLH
                &kp N4        &kp N5        &kp N6        &kp KP_PLUS     &kp KP_MINUS   &kp STAR &kp FSLH
                &kp N1        &kp N2        &kp N3        &kp DOT         &kp N0        &kp EQUAL     &kp BSPC
                &trans        &trans        &trans        &trans          &trans        &kp RET       &trans
            >;
        };


        /*
         * ============================================================
         * SYMBOLS
         * ============================================================
         *
         * LEFT:
         *
         * ! @ # $ % ^ &
         * * ( ) _ + =
         * { } [ ] \ |
         *
         * RIGHT:
         *
         * ~ ` < > : "
         * ; ' ? ! @ #
         * $ % ^ & * (
         *
         * ============================================================
         */

        sym_layer {
            bindings = <
                /* LEFT */
                &kp EXCL      &kp AT       &kp HASH      &kp DLLR      &kp PRCNT     &kp CARET     &kp AMPS
                &kp STAR      &kp LPAR     &kp RPAR      &kp UNDER     &kp PLUS      &kp EQUAL     &kp GRAVE
                &kp LBRC      &kp RBRC     &kp LBKT      &kp RBKT      &kp BSLH      &kp PIPE      &kp TILDE
                &trans        &trans       &trans       &trans        &trans        &trans        &trans

                /* RIGHT */
                &kp TILDE     &kp GRAVE     &kp LT        &kp GT        &kp COLON     &kp DQT       &kp PIPE
                &kp SEMI      &kp SQT       &kp QMARK     &kp EXCL       &kp AT        &kp HASH      &kp DLLR
                &kp PRCNT     &kp CARET     &kp AMPS      &kp STAR       &kp LPAR      &kp RPAR      &kp BSPC
                &trans        &trans        &trans       &trans         &trans        &trans        &trans
            >;
        };


        /*
         * ============================================================
         * NAVIGATION
         * ============================================================
         */

        nav_layer {
            bindings = <
                /* LEFT */
                &kp ESC       &kp HOME      &kp UP        &kp END       &kp PG_UP     &kp INSERT    &kp DEL
                &kp LEFT      &kp DOWN      &kp RIGHT     &kp BSPC      &kp C_VOL_UP  &kp C_VOL_DN  &kp C_MUTE
                &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp PAGE_UP   &kp PAGE_DOWN &kp HOME      &kp END
                &trans        &trans        &trans        &trans        &trans        &trans        &trans

                /* RIGHT */
                &kp HOME      &kp UP        &kp PG_UP     &kp END       &kp DEL       &kp INSERT    &kp ESC
                &kp LEFT      &kp DOWN      &kp RIGHT     &kp C_VOL_DN   &kp C_VOL_UP  &kp C_MUTE    &kp BSPC
                &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp PAGE_UP   &kp PAGE_DOWN &kp HOME      &kp END
                &trans        &trans        &trans        &trans        &trans        &trans        &trans
            >;
        };


        /*
         * ============================================================
         * BLUETOOTH
         * ============================================================
         *
         * Hold BT and press:
         *
         * 1 = profile 0
         * 2 = profile 1
         * 3 = profile 2
         * 4 = profile 3
         * 5 = profile 4
         *
         * BT_NXT = next profile
         * BT_PRV = previous profile
         *
         * ============================================================
         */

        bt_layer {
    bindings = <
        /* LEFT */
        &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &bt BT_NXT   &bt BT_PRV
        &bt BT_CLR     &bt BT_CLR_ALL &trans         &trans         &trans         &trans         &trans
        &trans         &trans         &trans         &trans         &trans         &trans         &trans
        &trans         &trans         &trans         &trans         &trans         &trans         &trans

        /* RIGHT */
        &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &bt BT_NXT   &bt BT_PRV
        &bt BT_CLR     &bt BT_CLR_ALL &trans         &trans         &trans         &trans         &trans
        &trans         &trans         &trans         &trans         &trans         &trans         &trans
        &trans         &trans         &trans         &trans         &trans         &trans         &trans
    >;
};

        /*
         * ============================================================
         * FUNCTION
         * ============================================================
         */

        func_layer {
            bindings = <
                /* LEFT */
                &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp F6        &kp F7
                &kp F8        &kp F9        &kp F10       &kp F11       &kp F12       &kp PRINT     &kp PAUSE
                &sys_reset    &bootloader   &kp K_LOCK    &kp C_BRI_UP   &kp C_BRI_DN   &kp C_MUTE     &kp C_PLAY
                &trans        &trans        &trans        &trans        &trans        &trans        &trans

                /* RIGHT */
                &kp F7        &kp F8        &kp F9        &kp F10       &kp F11       &kp F12       &kp PRINT
                &kp PAUSE     &kp K_LOCK     &sys_reset    &bootloader   &kp C_BRI_UP   &kp C_BRI_DN   &kp C_MUTE
                &kp C_PREV    &kp C_PP       &kp C_NEXT    &kp C_PLAY     &kp C_STOP     &trans        &kp BSPC
                &trans        &trans         &trans        &trans         &trans         &trans        &trans
            >;
        };
    };
};